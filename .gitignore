.cache/
node_modules/
dist/
.DS_Store

# Playwright run artifacts (the committed suite lives in e2e/; its output does not).
/test-results/
/playwright-report/

# Imported licensed translations (e.g. a NABRE you own) — on-device only, never committed.
*.local.json
nabre.local.json

# A personal Catechism file dropped into the bundle dir for conversion/review must never
# be committed — it is copyrighted, and the modern CCC text is never shipped. Import it
# on-device via Settings → Magisterium instead. (npm test also flags it as an unsealed file.)
/public/data/ccc/ccc.json

# Local iOS release credentials (App Store Connect API key details) — never committed.
scripts/ios-release.local.env

# Xcode Cloud build-log artifacts downloaded for debugging (contains signed IPA + dSYMs) — never committed.
/LOGS/

# App Store screenshots generated by the capture script (large PNGs, regenerable) — not committed.
/appstore/

# Visual-companion brainstorm sessions (mockups, server state) — never committed.
/.superpowers/

# One-shot corpus-merge/expansion helper scripts (throwaway tooling) — never committed.
/scripts/_*.mjs

# Stray file from a plutil -extract diagnostic (needs -o -); never a real path.
/-
