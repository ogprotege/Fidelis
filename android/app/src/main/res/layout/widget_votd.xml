<?xml version="1.0" encoding="utf-8"?>
<!-- Verse of the Day widget — mirrors ios/WidgetExtension/FidelisWidget.swift:
     a gold cross + label, the verse in italic serif, the citation in muted serif. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/votd_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:contentDescription="@string/widget_votd_description"
    android:focusable="true"
    android:importantForAccessibility="yes"
    android:screenReaderFocusable="true"
    tools:targetApi="p"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:gravity="center_vertical"
        android:importantForAccessibility="noHideDescendants"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/votd_cross"
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:layout_marginEnd="5dp"
            android:contentDescription="@null"
            android:src="@drawable/ic_cross_gold" />

        <TextView
            android:id="@+id/votd_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="@string/widget_votd_label"
            android:textColor="@color/fidelis_gold_text"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/votd_text"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:fontFamily="serif"
        android:importantForAccessibility="no"
        android:lineSpacingMultiplier="1.05"
        android:maxLines="8"
        android:text="@string/widget_votd_preview_text"
        android:textColor="@color/fidelis_ink"
        android:textSize="14sp"
        android:textStyle="italic" />

    <TextView
        android:id="@+id/votd_reference"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fontFamily="serif"
        android:maxLines="1"
        android:ellipsize="end"
        android:importantForAccessibility="no"
        android:text="@string/widget_votd_preview_reference"
        android:textColor="@color/fidelis_muted"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
