<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- FID-NATIVE-002: the fidelis:// deep-link scheme the home-screen
                 widgets open (fidelis://mass, fidelis://today). Capacitor delivers
                 the intent's data URI to the web layer via appUrlOpen; src/App.tsx
                 routes it (mass → the Mass readings, today → Today). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="fidelis" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Verse of the Day home-screen widget. The AppWidget framework delivers
             APPWIDGET_UPDATE to this (non-exported) receiver; VOTD_MIDNIGHT is the
             app's own daily-rollover alarm. -->
        <receiver
            android:name=".VotdWidget"
            android:label="@string/widget_votd_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.fidelis.bible.VOTD_MIDNIGHT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/votd_widget_info" />
        </receiver>

        <!-- Today at Mass widget — the day's liturgical title + reading citations,
             from the pre-resolved res/raw/calendar.json. CALENDAR_MIDNIGHT is its
             own daily-rollover alarm. -->
        <receiver
            android:name=".CalendarWidget"
            android:label="@string/widget_calendar_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.fidelis.bible.CALENDAR_MIDNIGHT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- Quote of the Day widget — the day's saying from the Fathers/Doctors/
             saints, from the same res/raw/calendar.json. QUOTE_MIDNIGHT is its
             own daily-rollover alarm. -->
        <receiver
            android:name=".QuoteWidget"
            android:label="@string/widget_quote_name"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="app.fidelis.bible.QUOTE_MIDNIGHT" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quote_widget_info" />
        </receiver>

        <!-- Positive callback for AppWidgetManager.requestPinAppWidget(). The
             explicit one-shot PendingIntent can reach this private receiver;
             arbitrary external broadcasts cannot. -->
        <receiver
            android:name=".WidgetPinResultReceiver"
            android:exported="false" />

        <!-- System lifecycle changes that can invalidate "today" or clear the
             inexact midnight alarms. One coordinator refreshes and re-arms all
             installed widget families. -->
        <receiver
            android:name=".WidgetRefreshCoordinator"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
